[gd_scene load_steps=8 format=3 uid="uid://main_scene_01"]

[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="1_player_scn"]
[ext_resource type="PackedScene" path="res://scenes/hud.tscn" id="2_hud_scn"]
[ext_resource type="Script" path="res://scripts/JuiceCamera2D.gd" id="3_juice_cam"]
[ext_resource type="Script" path="res://scripts/HitStopManager.gd" id="4_hit_stop"]
[ext_resource type="Script" path="res://scripts/grid.gd" id="5_grid_script"]
[ext_resource type="Script" path="res://scripts/modes/time_attack.gd" id="6_time_attack"]

[sub_resource type="GDScript" id="GDScript_main"]
script/source = "extends Node2D

@onready var grid_node: Node2D = $FusionGrid
@onready var time_attack_node: Node = $TimeAttackMode

func _ready() -> void:
	if GameManager:
		GameManager.start_new_game(1)

func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_FOCUS_OUT:
		if EventBus and not get_tree().paused:
			EventBus.pause_requested.emit()
"

[node name="Main" type="Node2D"]
script = SubResource("GDScript_main")

[node name="Background" type="ColorRect" parent="."]
offset_right = 1280.0
offset_bottom = 720.0
color = Color(0.03, 0.05, 0.11, 1)

[node name="HitStopManager" type="Node" parent="."]
script = ExtResource("4_hit_stop")

[node name="FusionGrid" type="Node2D" parent="."]
script = ExtResource("5_grid_script")

[node name="TimeAttackMode" type="Node" parent="."]
script = ExtResource("6_time_attack")

[node name="Player" parent="." instance=ExtResource("1_player_scn")]
position = Vector2(640, 110)

[node name="Camera2D" type="Camera2D" parent="."]
position = Vector2(640, 360)
script = ExtResource("3_juice_cam")

[node name="HUD" parent="." instance=ExtResource("2_hud_scn")]
